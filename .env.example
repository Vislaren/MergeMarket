# ─────────────────────────────────────────────────────────────────────────
# MergeMarket — Environment Variables (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this `.env.example` is committed as the canonical list of required vars.
#
#   cp .env.example .env
#
# docker-compose.yml reads `.env` automatically. The Go services also read
# these same variables from the environment (never hardcode config).
# ─────────────────────────────────────────────────────────────────────────

# ── Docker Compose ─────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=mergemarket

# ── PostgreSQL / TimescaleDB (single instance, shared connection) ───────────
# The app uses one timescale/timescaledb container that serves BOTH the
# relational tables and the price_history hypertable. DB_* and TIMESCALE_*
# therefore point at the same host:port (see DATABASE_SCHEMA.md §4).
# Host-run Go services connect via localhost; in-container clients use the
# compose service name `postgres`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mergemarket
DB_USER=postgres
DB_PASSWORD=changeme

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme
JWT_EXPIRY_HOURS=1
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Service ports ────────────────────────────────────────────────────────────
AUTH_PORT=8081
BFF_PORT=8082
SCRAPER_PORT=8083
NORMALIZATION_PORT=8084
HISTORY_PORT=8085
PROXY_VALIDATOR_PORT=8086

# ── Proxy Validator service (A-04) ───────────────────────────────────────────
# Public proxy-list sources (comma-separated). Empty = built-in default list.
PROXY_SOURCES=
# Redis Set key + TTL for the working pool (DATABASE_SCHEMA.md §3: proxy_pool/5m).
PROXY_POOL_KEY=proxy_pool
PROXY_POOL_TTL=5m
# Real endpoint each proxy is tested against, and the per-proxy timeout.
PROXY_TEST_URL=http://www.google.com/generate_204
PROXY_TEST_TIMEOUT=8s
# Max simultaneous validations and how often the full cycle runs (< POOL_TTL).
PROXY_VALIDATOR_CONCURRENCY=50
PROXY_REFRESH_INTERVAL=4m
# Adaptive politeness delay window between outbound validation requests.
PROXY_POLITENESS_MIN=50ms
PROXY_POLITENESS_MAX=400ms

# ── Kong API Gateway (DB-less mode) ──────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001
KONG_ADMIN_SSL_PORT=8444

# ── SonarQube ─────────────────────────────────────────────────────────────────
# For the VPS instance use the real IP (A-11): http://95.111.228.35:9000
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=changeme
# Dedicated database that backs the local SonarQube container (not exposed to host)
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# ── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_SERVER_KEY=changeme
