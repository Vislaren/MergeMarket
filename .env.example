# ─────────────────────────────────────────────────────────────────────────
# MergeMarket — Environment Variables (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this `.env.example` is committed as the canonical list of required vars.
#
#   cp .env.example .env
#
# docker-compose.yml reads `.env` automatically. The Go services also read
# these same variables from the environment (never hardcode config).
# ─────────────────────────────────────────────────────────────────────────

# ── Docker Compose ─────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=mergemarket

# ── PostgreSQL / TimescaleDB (single instance, shared connection) ───────────
# The app uses one timescale/timescaledb container that serves BOTH the
# relational tables and the price_history hypertable. DB_* and TIMESCALE_*
# therefore point at the same host:port (see DATABASE_SCHEMA.md §4).
# Host-run Go services connect via localhost; in-container clients use the
# compose service name `postgres`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mergemarket
DB_USER=postgres
DB_PASSWORD=TdXOZmU4uZGkziEP7M35BClSuWQlzChIRyv7ZofKnp8=

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dc40bd8ac70ec059291d259e22eafb3cccf30457563fc233f796f27a0f4100bb5727370e72341edd5658b2fc4302eff914d74435a6c740fe61defd90f3c1c57a
JWT_EXPIRY_HOURS=1
REFRESH_TOKEN_EXPIRY_DAYS=30
# AES-256-GCM key used to encrypt Redis session payloads at rest.
AUTH_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Auth service enforces TLS 1.3; point these at mounted certificate files.
AUTH_TLS_CERT_FILE=certs/auth.local.crt
AUTH_TLS_KEY_FILE=certs/auth.local.key
# Contract-required Redis session TTL. Keep this at 1h.
AUTH_SESSION_TTL=1h

# ── Service ports ────────────────────────────────────────────────────────────
AUTH_PORT=8091
BFF_PORT=8082
SCRAPER_PORT=8083
NORMALIZATION_PORT=8084
HISTORY_PORT=8085
PROXY_VALIDATOR_PORT=8086

# ── Proxy Validator service (A-04) ───────────────────────────────────────────
# Public proxy-list sources (comma-separated). Empty = built-in default list.
PROXY_SOURCES=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt,https://raw.githubusercontent.com/clarketm/proxy-list/master/proxy-list-raw.txt,https://raw.githubusercontent.com/ShiftyTR/Proxy-List/master/http.txt
# Redis Set key + TTL for the working pool (DATABASE_SCHEMA.md §3: proxy_pool/5m).
PROXY_POOL_KEY=proxy_pool
PROXY_POOL_TTL=5m
# Real endpoint each proxy is tested against, and the per-proxy timeout.
PROXY_TEST_URL=http://www.google.com/generate_204
PROXY_TEST_TIMEOUT=8s
# Max simultaneous validations and how often the full cycle runs (< POOL_TTL).
PROXY_VALIDATOR_CONCURRENCY=50
PROXY_REFRESH_INTERVAL=4m
# Adaptive politeness delay window between outbound validation requests.
PROXY_POLITENESS_MIN=50ms
PROXY_POLITENESS_MAX=400ms

# ── Scraper service (A-05) ───────────────────────────────────────────────────
# Directory of per-store StoreConfig files (one .json/.yaml/.yml per store).
SCRAPER_CONFIG_DIR=configs
# Number of concurrent worker goroutines consuming scrape jobs.
SCRAPER_WORKERS=10
# Redis list keys: incoming jobs (in) and raw results for normalization (out).
SCRAPER_JOB_QUEUE=scrape_queue
SCRAPER_NORMALIZE_QUEUE=normalize_queue
# Bound on each blocking dequeue (keeps workers responsive to shutdown).
SCRAPER_QUEUE_POLL_TIMEOUT=5s
# Per-store request timeout for a single scrape.
SCRAPER_SCRAPE_TIMEOUT=15s
# Circuit breaker: consecutive 403/429 to trip open, and the open cooldown.
SCRAPER_CIRCUIT_THRESHOLD=5
SCRAPER_CIRCUIT_COOLDOWN=60s
# Route scrape requests through a proxy_pool member (false = direct connections).
SCRAPER_USE_PROXY=true

# ── Normalization service (A-06) ─────────────────────────────────────────────
# Consumes the scraper's SCRAPER_NORMALIZE_QUEUE, normalizes products, injects
# affiliate links, and upserts into PostgreSQL (DB_* / DATABASE_URL above).
NORMALIZATION_WORKERS=5
NORMALIZATION_QUEUE_POLL_TIMEOUT=5s
# Path to the Affiliate Link Injection config (empty = links pass through
# unchanged). See services/normalization/configs/affiliates.example.json.
NORMALIZATION_AFFILIATE_CONFIG=

# ── History service (A-07) ───────────────────────────────────────────────────
# Records price snapshots to TimescaleDB and fires price-drop alerts.
HISTORY_SNAPSHOT_INTERVAL=24h
HISTORY_SNAPSHOT_ON_START=false
HISTORY_HEARTBEAT_INTERVAL=1h
HISTORY_HEARTBEAT_ON_START=true
# Price source for the heartbeat: "db" (use products.last_price) or "http"
# (re-fetch the product URL and extract an embedded price — best effort).
HISTORY_HEARTBEAT_MODE=db
HISTORY_HEARTBEAT_TIMEOUT=10s
# Redis list fired price-drop alert events are pushed to (Notification Worker).
HISTORY_ALERT_QUEUE=price_alert_events

# ── Kong API Gateway (DB-less mode) ──────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001
KONG_ADMIN_SSL_PORT=8444

# ── SonarQube ─────────────────────────────────────────────────────────────────
# For the VPS instance use the real IP (A-11): http://95.111.228.35:9000
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=squ_3fb7160be8187a314e852ef03a4851b045d38780
# Dedicated database that backs the local SonarQube container (not exposed to host)
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# ── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_SERVER_KEY=changeme
