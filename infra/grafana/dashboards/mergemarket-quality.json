    {
      "id": 4,
      "type": "piechart",
      "title": "Pipeline Pass/Fail Rate (last 50 runs)",
      "description": "Conclusions of the most recent GitHub Actions workflow runs. Empty until the GitHub Actions workflow is active (CI currently runs on Jenkins — see docs/grafana-setup.md).",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github_api" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "failure" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "pieType": "donut",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "values": ["value", "percent"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github_api" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/repos/${gh_repo}/actions/runs?per_page=50",
          "url_options": { "method": "GET" },
          "root_selector": "workflow_runs",
          "columns": [
            { "selector": "conclusion", "text": "conclusion", "type": "string" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "conclusion": { "aggregations": [], "operation": "groupby" }
            }
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "conclusion": { "aggregations": ["count"], "operation": "aggregate" }
            }
          }
        }
      ]
    },
