      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "sonarqube_api" },
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "url": "/api/measures/search_history?component=${sonar_project}&metrics=bugs&ps=1000",
