    {
      "id": 7,
      "type": "timeseries",
      "title": "Pipeline Build Duration Over Time",
      "description": "Per-run duration (updated_at − run_started_at) for recent GitHub Actions runs. Empty until the GitHub Actions workflow is active — CI currently runs on Jenkins (see docs/grafana-setup.md).",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github_api" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "github_api" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/repos/${gh_repo}/actions/runs?per_page=50",
          "url_options": { "method": "GET" },
          "root_selector": "workflow_runs",
          "columns": [
            { "selector": "run_started_at", "text": "started", "type": "timestamp" },
            { "selector": "updated_at", "text": "ended", "type": "timestamp" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "started", "destinationType": "number" },
              { "targetField": "ended", "destinationType": "number" }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "duration_ms",
            "mode": "binary",
            "binary": { "left": "ended", "operator": "-", "right": "started" },
            "replaceFields": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "started", "destinationType": "time" }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "ended": true },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    }
